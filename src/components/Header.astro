---
import { Image } from 'astro:assets';

import ModeToggle from '@/components/ModeToggle';
import { BanglaDate } from '@/components/BanglaDate';

import logo from '../assets/images/logo-base.svg';
---

<header
  class="supports-backdrop-blur:bg-surface-1/80 bg-surface-0/80 sticky top-0 z-40 w-full border-b py-4 backdrop-blur-sm lg:py-8"
>
  <div
    class="mx-auto flex justify-between px-4 md:max-w-2xl lg:max-w-4xl lg:px-0"
  >
    <a
      href={`/`}
      class="hover:text-accent text-fg-0 flex items-center text-lg no-underline"
    >
      <Image src={logo} alt="logo" class="size-6" />
      hahid
    </a>
    <div class="flex items-center">
      <BanglaDate client:load />
      <div
        class="ml-4 flex items-center border-l-2 border-dotted pl-2 *:pr-4 *:last:pr-0"
      >
        <ModeToggle client:load />
      </div>
    </div>
  </div>
</header>
